# IT-CLUB EMSP — variables d'environnement backend (EXEMPLE, sans secrets).
# Copier vers backend/.env (jamais commité — voir .gitignore) :
#   cp backend/.env.example backend/.env
#
# ── Django ──
DJANGO_SECRET_KEY=change-moi-en-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#
# ── Base de données : Neon (recommandé) ou SQLite par défaut ──
# Coller ici l'URL poolée du dashboard Neon (…-pooler.…neon.tech/…?sslmode=require)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/itclubemsp?sslmode=require
# Avec le pooler Neon, garder 0 (le pooler gère les connexions persistantes) :
# DB_CONN_MAX_AGE=0
#
# ── Emails Resend (doc 09) ──
# RESEND_API_KEY=re_... (clé lue depuis ~/.hermes/.env en dev, jamais dans le repo)
# Sans domaine vérifié : RESEND_FROM utilise onboarding@resend.dev (tests uniquement,
# destinataires limités). Après vérification d'un domaine sur resend.com/domains :
# RESEND_FROM=IT-CLUB EMSP <noreply@ton-domaine>
# RESEND_FROM=
FRONTEND_URL=https://it-club-emsp.vercel.app
#
# ── CORS local ──
CORS_ALLOWED_ORIGINS=http://localhost:5200,http://127.0.0.1:5200,https://it-club-emsp.vercel.app
